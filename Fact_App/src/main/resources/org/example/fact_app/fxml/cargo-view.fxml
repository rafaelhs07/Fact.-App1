<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="500.0"
            prefWidth="750.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.fact_app.controller.CargoController">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #2b2b2b; -fx-padding: 15;">
            <children>
                <Label text="Gestión de Cargos" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
            </padding>

            <children>
                <!-- Panel izquierdo: formulario -->
                <VBox prefWidth="280.0" spacing="15.0">
                    <children>
                        <GridPane hgap="10.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="60.0"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>
                                <Label text="ID:"/>

                                <TextField fx:id="txtId"
                                           disable="true"
                                           promptText="Autogenerado"
                                           GridPane.columnIndex="1"/>

                                <Label text="Nombre:"
                                       GridPane.rowIndex="1"/>

                                <TextField fx:id="txtNombre"
                                           promptText="Ej. Administrador"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>
                            </children>

                            <rowConstraints>
                                <RowConstraints/>
                                <RowConstraints/>
                                <RowConstraints/>
                            </rowConstraints>
                        </GridPane>

                        <!-- Botones de acción -->
                        <VBox spacing="8.0">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="btnGuardar"
                                                maxWidth="Infinity"
                                                onAction="#onGuardar"
                                                text="Guardar"
                                                HBox.hgrow="ALWAYS"/>

                                        <Button fx:id="btnActualizar"
                                                maxWidth="Infinity"
                                                onAction="#onActualizar"
                                                text="Modificar"
                                                HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="btnEliminar"
                                                maxWidth="Infinity"
                                                onAction="#onEliminar"
                                                text="Eliminar"
                                                HBox.hgrow="ALWAYS"/>

                                        <Button fx:id="btnLimpiar"
                                                maxWidth="Infinity"
                                                onAction="#onLimpiar"
                                                text="Limpiar"
                                                HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>

                                <Button fx:id="btnVolver"
                                        maxWidth="Infinity"
                                        onAction="#onVolver"
                                        text="← Volver al Menú"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Panel derecho: tabla de registros -->
                <TableView fx:id="tblDatos" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"
                                     prefWidth="60.0"
                                     text="ID"/>

                        <TableColumn fx:id="colNombre"
                                     prefWidth="150.0"
                                     text="Nombre"/>
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </HBox>
    </center>

</BorderPane>