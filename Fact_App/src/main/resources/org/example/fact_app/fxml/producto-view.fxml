<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0"
            prefWidth="1050.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.fact_app.controller.ProductoController">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #2b2b2b; -fx-padding: 15;">

            <Label text="Gestión de Productos" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
            </Label>

        </HBox>
    </top>

    <center>
        <HBox spacing="20.0">

            <padding>
                <Insets top="15.0"
                        right="15.0"
                        bottom="15.0"
                        left="15.0"/>
            </padding>

            <!-- Formulario -->
            <VBox minWidth="310.0"
                  prefWidth="310.0"
                  spacing="15.0">

                <GridPane hgap="10.0" vgap="12.0">

                    <columnConstraints>
                        <ColumnConstraints minWidth="75.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <children>

                        <Label text="Código:"
                               GridPane.rowIndex="0"/>

                        <TextField fx:id="txtCodigo"
                                   promptText="Ej. P001"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Nombre:"
                               GridPane.rowIndex="1"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Nombre del producto"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                        <Label text="Categoría:"
                               GridPane.rowIndex="2"/>

                        <ComboBox fx:id="cmbCategoria"
                                  maxWidth="Infinity"
                                  promptText="Seleccione una categoría"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="2"/>

                        <Label text="Precio:"
                               GridPane.rowIndex="3"/>

                        <TextField fx:id="txtPrecio"
                                   promptText="Ej. 150.00"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3"/>

                        <Label text="Existencia:"
                               GridPane.rowIndex="4"/>

                        <TextField fx:id="txtExistencia"
                                   promptText="Ej. 10"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="4"/>

                        <Label text="Estado:"
                               GridPane.rowIndex="5"/>

                        <CheckBox fx:id="chkActivo"
                                  text="Activo"
                                  selected="true"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="5"/>

                    </children>
                </GridPane>

                <!-- Imagen del producto -->
                <VBox alignment="CENTER" spacing="10.0">

                    <Label text="Imagen del producto"/>

                    <StackPane prefHeight="130.0"
                               style="-fx-background-color: #f4f4f4;
                                      -fx-border-color: #cccccc;">

                        <ImageView fx:id="imgProducto"
                                   fitWidth="180.0"
                                   fitHeight="120.0"
                                   preserveRatio="true"/>

                    </StackPane>

                    <Button fx:id="btnImagen"
                            text="Seleccionar imagen"
                            maxWidth="Infinity"
                            onAction="#seleccionarImagen"/>

                </VBox>

                <!-- Acciones -->
                <VBox spacing="8.0">

                    <Button fx:id="btnGuardar"
                            text="Guardar"
                            maxWidth="Infinity"
                            onAction="#guardar"/>

                    <Button fx:id="btnCerrar"
                            text="← Volver al Menú"
                            maxWidth="Infinity"
                            onAction="#cerrar"/>

                </VBox>

            </VBox>

            <!-- Tabla de productos -->
            <TableView fx:id="tblProductos" HBox.hgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="80.0"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="110.0"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="90.0"/>

                    <TableColumn fx:id="colExistencia"
                                 text="Existencia"
                                 prefWidth="85.0"/>

                    <TableColumn fx:id="colActivo"
                                 text="Activo"
                                 prefWidth="75.0"/>

                </columns>

                <placeholder>
                    <Label text="No hay productos registrados."/>
                </placeholder>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

            </TableView>

        </HBox>
    </center>

</BorderPane>